# Copy to .env and fill in. Never commit .env.
PORT=4000
DATABASE_PATH=./data/milan.db
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGIN=*
# Insert the sample events when the database is empty
SEED_ON_START=true
