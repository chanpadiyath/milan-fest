{
  "name": "milan-api",
  "version": "1.0.0",
  "description": "REST API for Milan fest event discovery and participant registration",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
